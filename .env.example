# Proveedor del modelo de IA: "local" (heurístico, por defecto) o "bedrock"
MODEL_PROVIDER=local

# Configuración usada únicamente cuando MODEL_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directorio donde se guardan los datos simulados (data/complaints.jsonl)
DATA_DIR=./data

# Activa o desactiva el registro de eventos en data/complaints.jsonl
PERSIST_COMPLAINTS=true
